{
  "name": "@nuttie/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist && node ../../tools/patch-web-export.mjs dist && node ../../tools/verify-web-export.mjs dist",
    "verify:web-export": "node ../../tools/verify-web-export.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nuttie/contracts": "workspace:*",
    "@nuttie/design-tokens": "workspace:*",
    "@nuttie/domain": "workspace:*",
    "@nuttie/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "0.468.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
