# The browser uses same-origin /api calls, so EXPO_PUBLIC_API_URL is not needed.
# Zeabur build setting when this repository is connected directly.
ZBPACK_DOCKERFILE_NAME=web
# Zeabur normally injects PORT. This is the private DNS and port assigned to
# the current Zeabur api service. For local Compose, use http://api:8787
# instead; do not copy that Compose-only value into Zeabur.
# PORT=8080
API_UPSTREAM=http://api.zeabur.internal:8080
ENABLE_HSTS=true
