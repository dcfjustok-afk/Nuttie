# The browser uses same-origin /api calls, so EXPO_PUBLIC_API_URL is not needed.
# Zeabur build setting when this repository is connected directly.
ZBPACK_DOCKERFILE_NAME=web
# Zeabur normally injects PORT. API_UPSTREAM uses the private api service name.
# PORT=8080
API_UPSTREAM=http://api:8787
ENABLE_HSTS=true
