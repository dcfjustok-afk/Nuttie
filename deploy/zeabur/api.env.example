# Copy these values into the Zeabur api service; never commit real secrets.
NODE_ENV=production
# Zeabur build setting when this repository is connected directly.
ZBPACK_DOCKERFILE_NAME=api
ALLOW_IN_MEMORY=false
# Zeabur normally injects PORT. Keep this commented unless running the image yourself.
# PORT=8787
DATABASE_URL=${POSTGRES_CONNECTION_STRING}
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=https://your-web-domain.example
MIGRATION_ATTEMPTS=30
MIGRATION_RETRY_DELAY_SECONDS=2
