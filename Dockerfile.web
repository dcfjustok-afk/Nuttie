# syntax=docker/dockerfile:1.7

FROM public.ecr.aws/docker/library/node:22-alpine AS build

ENV CI=true \
    EXPO_NO_DOCTOR=1 \
    EXPO_NO_TELEMETRY=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    npm_config_node_linker=hoisted \
    npm_config_shared_workspace_lockfile=true \
    npm_config_auto_install_peers=true \
    npm_config_registry=https://registry.npmjs.org/

WORKDIR /workspace

RUN corepack enable \
  && corepack prepare pnpm@11.18.0 --activate

# Copy manifests first so dependency installation remains cacheable when app code changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/app/package.json apps/app/tsconfig.json apps/app/app.json apps/app/expo-env.d.ts ./apps/app/
COPY packages/contracts/package.json packages/contracts/tsconfig.json ./packages/contracts/
COPY packages/domain/package.json packages/domain/tsconfig.json ./packages/domain/
COPY packages/design-tokens/package.json packages/design-tokens/tsconfig.json ./packages/design-tokens/
COPY packages/ui/package.json packages/ui/tsconfig.json ./packages/ui/
COPY services/api/package.json services/api/tsconfig.json ./services/api/

RUN pnpm install --frozen-lockfile

COPY packages ./packages
COPY apps/app ./apps/app
COPY tools/patch-web-export.mjs ./tools/patch-web-export.mjs
COPY tools/web-export-contract.mjs ./tools/web-export-contract.mjs
COPY tools/verify-web-export.mjs ./tools/verify-web-export.mjs

RUN pnpm --filter @nuttie/contracts build \
  && pnpm --filter @nuttie/domain build \
  && pnpm --filter @nuttie/design-tokens build \
  && pnpm --filter @nuttie/ui build \
  && pnpm --filter @nuttie/app export:web

FROM public.ecr.aws/docker/library/nginx:1.27-alpine

ENV PORT=8080 \
    API_UPSTREAM=http://api:8787 \
    ENABLE_HSTS=true \
    NGINX_ENVSUBST_FILTER=^(PORT|API_UPSTREAM|ENABLE_HSTS)$

RUN mkdir -p /etc/nginx/snippets

COPY deploy/nginx/nuttie.conf /etc/nginx/templates/default.conf.template
COPY deploy/nginx/security-headers.conf /etc/nginx/snippets/nuttie-security-headers.conf

# Validate the rendered template during CI. The official entrypoint renders it
# again at startup with the service's actual PORT/API_UPSTREAM values.
RUN API_UPSTREAM=http://127.0.0.1:8787 \
  envsubst '${PORT} ${API_UPSTREAM} ${ENABLE_HSTS}' \
  < /etc/nginx/templates/default.conf.template \
  > /etc/nginx/conf.d/nuttie-build-check.conf \
  && nginx -t \
  && rm /etc/nginx/conf.d/nuttie-build-check.conf

COPY --from=build /workspace/apps/app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD ["sh", "-c", "wget -q -O /dev/null http://127.0.0.1:${PORT:-8080}/healthz || exit 1"]
