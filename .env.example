# Local compose defaults only. Never use these credentials in production.
POSTGRES_DB=nuttie
POSTGRES_USER=nuttie
POSTGRES_PASSWORD=nuttie_dev_password
POSTGRES_PORT=5432
API_PORT=8787
WEB_PORT=4187
ENABLE_HSTS=false
ACCESS_TOKEN_SECRET=local-development-access-token-secret-change-me
ALLOWED_ORIGINS=http://localhost:4187,http://localhost:8081,http://localhost:19006

# Zeabur/production values belong in the service environment, not this file:
# NODE_ENV=production
# ALLOW_IN_MEMORY=false
# DATABASE_URL=postgresql://...
# ACCESS_TOKEN_SECRET=<random value with at least 32 characters>
