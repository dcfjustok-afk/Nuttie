{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuttie.local/schemas/owner-intake.schema.json",
  "title": "Nuttie Owner Intake",
  "type": "object",
  "required": [
    "schemaVersion",
    "batchId",
    "channel",
    "status",
    "updatedAt",
    "acceptanceStateChanged",
    "responses",
    "facts",
    "conflicts",
    "nextQuestion"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "batchId": { "type": "string", "minLength": 1 },
    "channel": { "const": "CODEX_REQUEST_USER_INPUT" },
    "status": {
      "enum": [
        "IN_PROGRESS",
        "IN_PROGRESS_MODE_INTERRUPTED",
        "AWAITING_BATCH_READBACK",
        "AWAITING_FINAL_CONFIRMATION",
        "CONFIRMED"
      ]
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "acceptanceStateChanged": { "const": false },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["questionId", "decisionId", "optionKey", "optionLabel", "state"],
        "properties": {
          "questionId": { "type": "string" },
          "decisionId": { "pattern": "^D-[0-9]{3}$" },
          "optionKey": { "type": "string" },
          "optionLabel": { "type": "string" },
          "state": { "const": "PENDING_BATCH_READBACK" },
          "semantics": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "facts": { "type": "array", "items": { "type": "object" } },
    "conflicts": { "type": "array", "items": { "type": "object" } },
    "nextQuestion": { "type": "object" }
  },
  "additionalProperties": false
}
